<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" style="-fx-background-color: #a6a6a6"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.MatrimonioController">
    <top>
        <VBox spacing="5.0" style="-fx-background-color: #a6a6a6">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
            </padding>
            <Label text="REGISTRO CIVIL" textFill="black">
                <font>
                    <Font name="System Bold" size="13.0"/>
                </font>
            </Label>
            <Label text="Padrón de matrimonios" textFill="Black">
                <font>
                    <Font name="System Bold" size="25.0"/>
                </font>
            </Label>
            <Label text="Sistema de registro y consulta de uniones civiles" textFill="Black"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
            </padding>
            <TitledPane collapsible="false" expanded="true" text="Datos del acta de matrimonio">
                <GridPane hgap="12.0" style="-fx-background-color: #c8c8c8" vgap="10.0">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints minWidth="150.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="150.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Número de acta:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtActa" promptText="Ej. 2026-001"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Fecha de celebración:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="Seleccionar fecha"
                                GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Contrayente 1:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtContrayente1" promptText="Nombres y apellidos"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Contrayente 2:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtContrayente2" promptText="Nombres y apellidos"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Lugar:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtLugar" promptText="Municipalidad, ciudad o dirección"
                               GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
                </GridPane>
            </TitledPane>

            <HBox spacing="9.0">
                <Button onAction="#guardar" text="Guardar"
                        style="-fx-background-color: #247a4b; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button onAction="#actualizar" text="Actualizar"
                        style="-fx-background-color: #2463a6; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button onAction="#eliminar" text="Eliminar"
                        style="-fx-background-color: #b83232; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button onAction="#limpiar" text="Limpiar"/>
                <Button onAction="#listar" text="Mostrar todos"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre de cualquiera de los contrayentes"
                           HBox.hgrow="ALWAYS"/>
                <Button onAction="#buscar" text="Buscar"/>

            </HBox>

            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="55.0" text="ID"/>
                    <TableColumn fx:id="colActa" prefWidth="110.0" text="N.º de acta"/>
                    <TableColumn fx:id="colContrayente1" prefWidth="200.0" text="Contrayente 1"/>
                    <TableColumn fx:id="colContrayente2" prefWidth="200.0" text="Contrayente 2"/>
                    <TableColumn fx:id="colFecha" prefWidth="110.0" text="Fecha"/>
                    <TableColumn fx:id="colLugar" prefWidth="200.0" text="Lugar"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblEstado" text="Registro de matrimonios :D" textFill="BLACK"/>
        </VBox>
    </center>

</BorderPane>
